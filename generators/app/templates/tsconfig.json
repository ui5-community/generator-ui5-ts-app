{
	"compilerOptions": {
		"target": "es2023",
		"module": "es2022",
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"allowJs": true,
		"strict": true,
		"strictNullChecks": false,
		"strictPropertyInitialization": false,
		"rootDir": "./webapp",<% if (viewType === "TSX") { %>
		"jsx": "react-jsx",
		"jsxImportSource": "ui5/community/jsx/runtime",<% } %>
		"types": ["<%= tstypes %>", "@types/qunit"<% if (viewType === "TSX") { %>, "@ui5-community/jsx-runtime"<% } %>],
		"paths": {
			"<%= appURI %>/*": ["./webapp/*"],
			"unit/*": ["./webapp/test/unit/*"],
			"integration/*": ["./webapp/test/integration/*"]
		}
	},
	"exclude": ["./webapp/test/e2e/**/*"],
	"include": ["./webapp/**/*"]
}
